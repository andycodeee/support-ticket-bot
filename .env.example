# ---- Discord ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
SUPPORT_CHANNEL_ID=
# Comma-separated role IDs allowed to respond to tickets (admins are always allowed)
SUPPORT_ROLE_IDS=

# ---- API ----
API_BASE_URL=https://api.bookscover.store
# Shared secret used by Roblox AND the bot. Use a long random string (32+ chars).
API_SECRET=

# ---- AI ticket translation/review (optional) ----
AI_ENABLED=false
# Choose "gemini" or "ollama". Gemini needs an AI Studio API key.
AI_PROVIDER=ollama
# Leave AI_MODEL empty to use the provider's default model.
AI_MODEL=
AI_API_KEY=
# Ollama only; Gemini uses Google's API endpoint.
AI_BASE_URL=http://127.0.0.1:11434
AI_TIMEOUT_MS=30000

# How often the bot checks the API for new tickets and retries queued responses
POLL_INTERVAL_MS=10000

# ---- Roblox Open Cloud (for /checkpurchase) ----
# Server-side key with Standard DataStore read access. Never commit or share it.
ROBLOX_API_KEY=
ROBLOX_UNIVERSE_ID=

# ---- Storage / runtime ----
# Local dev: ./data/support.sqlite   |   Railway: /data/support.sqlite (on a volume)
DB_PATH=./data/support.sqlite
# Railway sets PORT automatically; locally defaults to 3000
PORT=3000

# ---- Channel for the "Other" category (optional) ----
# If empty, "Other" tickets go to SUPPORT_CHANNEL_ID.
OTHER_SUPPORT_CHANNEL_ID=

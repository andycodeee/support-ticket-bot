# ---- Discord ----
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
SUPPORT_CHANNEL_ID=
# Comma-separated role IDs allowed to respond to tickets (admins are always allowed)
SUPPORT_ROLE_IDS=

# ---- API ----
API_BASE_URL=https://api.bookscover.store
# Shared secret used by Roblox AND the bot. Use a long random string (32+ chars).
API_SECRET=

# How often the bot checks the API for new tickets and retries queued responses
POLL_INTERVAL_MS=10000

# ---- Roblox Open Cloud (for /checkpurchase) ----
# Server-side key with Standard DataStore read access. Never commit or share it.
ROBLOX_API_KEY=
ROBLOX_UNIVERSE_ID=

# ---- Storage / runtime ----
# Local dev: ./data/support.sqlite   |   Railway: /data/support.sqlite (on a volume)
DB_PATH=./data/support.sqlite
# Railway sets PORT automatically; locally defaults to 3000
PORT=3000
